* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
# Frozen artifacts are byte-addressed by SHA-256; preserve exact bytes on all hosts.
/splits/faircsar_local_v1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/splits/faircsar_local_v2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
